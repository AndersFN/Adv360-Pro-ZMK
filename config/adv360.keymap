#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none          &kp N1            &kp N2             &kp N3                &kp N4                 &kp N5  &none                                                             &none              &kp N6  &kp N7          &kp N8           &kp N9        &kp N0           &mo 4
&none          &kp Q             &kp W              &kp E                 &kp R                  &kp T   &kp GRAVE                                                         &kp TILDE          &kp Y   &kp U           &kp I            &kp O         &kp P            &none
&kp SEMICOLON  &kp A             &kp S              &hm LGUI D            &hm LCTRL F            &kp G   &kp COLON    &none      &kp HOME       &kp PAGE_UP   &none        &kp DOUBLE_QUOTES  &kp H   &hm RCTRL J     &hm RGUI K  &kp L         &kp BACKSPACE    &kp SQT
&kp LSHIFT     &kp Z             &kp X              &kp C                 &kp V                  &kp B                           &kp END        &kp PAGE_DOWN                                 &kp N   &kp M           &kp COMMA        &kp DOT       &kp FSLH         &kp RSHFT
&none          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS          &lt 1 SPACE  &kp TAB    &kp RALT       &kp LALT      &lt 2 ENTER  &lt 1 ESCAPE       &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW  &kp RIGHT_ARROW  &mo 3
            >;
        };

        numrow {
            bindings = <
&trans  &trans    &trans  &trans  &trans  &trans     &trans                                      &trans  &trans          &trans    &trans        &trans     &trans      &trans
&trans  &trans    &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans                                      &trans  &trans          &trans    &trans        &trans     &trans      &trans
&trans  &kp PLUS  &kp N4  &kp N5  &kp N6  &kp MINUS  &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp DELETE  &trans
&trans  &trans    &kp N7  &kp N8  &kp N9  &kp UNDER                  &trans      &trans                  &trans          &trans    &trans        &trans     &trans      &trans
&trans  &trans    &trans  &trans  &trans             &trans  &kp N0  &trans      &trans  &trans  &trans                  &trans    &trans        &trans     &trans      &trans
            >;
        };

        sym {
            bindings = <
&trans  &trans                &trans           &trans        &trans         &trans                 &trans                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_BRACE        &kp EXCLAMATION  &kp AT        &kp HASH       &kp RIGHT_BRACE        &trans                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_PARENTHESIS  &kp DOLLAR       &kp PERCENT   &kp CARET      &kp RIGHT_PARENTHESIS  &trans  &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_BRACKET      &kp AMPERSAND    &kp ASTERISK  &kp BACKSLASH  &kp RIGHT_BRACKET                        &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                &trans           &trans        &trans                                &trans  &kp PIPE  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2        &kp F3            &kp F4      &kp F5  &kp F6  &none                                       &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp C_VOL_DN  &kp C_VOL_UP      &kp C_MUTE  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans        &trans            &trans      &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans        &trans            &trans      &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        bt {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
